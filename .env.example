# 本地开发环境变量。复制为仓库根目录的 .env 后按需修改。
# 不要把真实密钥提交到仓库。下面的默认值只用于本机 Docker。

# 应用连接。rma_app 没有超级用户权限，数据库行级权限（RLS）才会生效。
# 第一次执行 pnpm db:migrate 时会创建这个账号。
DATABASE_URL=postgresql://rma_app:rma_app@localhost:15432/rma?schema=public

# Redis，当前骨架只启动服务，业务代码尚未使用
REDIS_URL=redis://localhost:6379

# API 监听端口（apps/api）
API_PORT=3001

# 浏览器访问 API 的地址（apps/web 会读取 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_API_URL=http://localhost:3001

# Prisma 迁移用的直连。必须是建库账号 rma，不能用上面的 rma_app。
DIRECT_URL=postgresql://rma:rma@localhost:15432/rma?schema=public

# Clerk。把占位符换成控制台里的真实值，不要提交真实密钥。
# Web 用 apps/web/.env.local，API 用 apps/api/.env。
CLERK_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
