# 本地开发环境变量。复制为仓库根目录的 .env 后按需修改。
# 不要把真实密钥提交到仓库。下面的默认值只用于本机 Docker。

# PostgreSQL。宿主机端口是 15432（容器内仍是 5432），账号与 docker-compose.yml 一致。
DATABASE_URL=postgresql://rma:rma@localhost:15432/rma?schema=public

# Redis，当前骨架只启动服务，业务代码尚未使用
REDIS_URL=redis://localhost:6379

# API 监听端口（apps/api）
API_PORT=3001

# 浏览器访问 API 的地址（apps/web 会读取 NEXT_PUBLIC_ 前缀）
NEXT_PUBLIC_API_URL=http://localhost:3001

# Prisma 迁移用的直连。本地与 DATABASE_URL 相同，宿主机端口是 15432。
DIRECT_URL=postgresql://rma:rma@localhost:15432/rma?schema=public
