{
  "name": "@rma/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/with-root-env.mjs nest start --watch",
    "dev:cloud": "node ../../scripts/with-root-env.mjs --env .env.supabase -- nest start --watch",
    "build": "nest build",
    "start": "node ../../scripts/with-root-env.mjs node dist/main.js",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@clerk/backend": "^3.27.0",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.1.0",
    "@rma/db": "workspace:*",
    "@rma/shared": "workspace:*",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^5.1.0"
  }
